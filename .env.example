# Discord — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands instantly to one server while developing.
# Leave blank in production so commands register globally (takes ~1h to propagate).
DEV_GUILD_ID=

# Postgres — matches docker-compose.yml defaults
DATABASE_URL=postgres://gacha:gacha@localhost:5432/gacha

# https://marvelrivalsapi.com — only needed to run `npm run ingest`
MARVEL_RIVALS_API_KEY=
