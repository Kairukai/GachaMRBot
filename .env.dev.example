# Development bot — a SEPARATE Discord application from the live one.
# Copy to .env.dev and fill in. Never point this at the live bot's token.

# From the dev application: Bot tab -> Reset Token
DISCORD_TOKEN=
# From the dev application: General Information -> Application ID
DISCORD_CLIENT_ID=

# The server you test in. Set (not blank!) so commands register instantly
# instead of taking up to an hour like the live bot's global registration.
DEV_GUILD_ID=1533799024820359419

# Separate database on the same Postgres container.
#
# This matters: the dev bot sits in the SAME Discord server as the live one, so
# guild_id is identical. Sharing a database would mean test rolls creating real
# claims — locking cards away from real players in a server you don't control.
DATABASE_URL=postgres://gacha:gacha@localhost:5432/gacha_dev

# Only needed for `npm run ingest:api`
MARVEL_RIVALS_API_KEY=
